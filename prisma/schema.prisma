generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STANDARD
  SERVICE
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ManagerApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum DrinkOrderStatus {
  NEW
  PREPARING
  SERVED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  phoneNumber  String?
  managerId    String?
  role         UserRole   @default(STANDARD)
  status       UserStatus @default(ACTIVE)
  manager      User?      @relation("UserManager", fields: [managerId], references: [id])
  directReports User[]    @relation("UserManager")
  managedReservations Reservation[] @relation("ReservationManager")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AppSettings {
  id             String      @id @default("default")
  siteTitle      String      @default("Room Reservation Hub")
  siteTitleArabic String?
  siteDescription String     @default("Internal platform for room bookings, approvals, and planning.")
  workWeekStart  Int         @default(0)
  workWeekEnd    Int         @default(4)
  upcomingReminderHours Int  @default(24)
  blockedDays    BlockedDay[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model BlockedDay {
  id         String      @id @default(cuid())
  settingsId String
  date       DateTime
  label      String
  notes      String?
  settings   AppSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([settingsId, date])
}

model Room {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  type         String
  capacity     Int
  location     String
  notes        String?
  status       RoomStatus    @default(ACTIVE)
  reservations Reservation[]
  serviceToken RoomServiceToken?
  drinkOrders  DrinkOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Reservation {
  id                String            @id @default(cuid())
  reservationCode   String            @unique
  roomId            String
  managerId         String?
  reservationDate   DateTime
  reservationEndDate DateTime
  startTime         String
  endTime           String
  reservationType   String
  guestCompany      String
  guestName         String?
  guestCompanyLogo  String?
  chargedCompany    String
  chargedDepartment String
  materialsToDisplay String?
  foodServiceRequired Boolean         @default(false)
  bookingCompany    String
  meetingName       String
  eventType         String
  requesterName     String
  requesterEmail    String
  contactNumber     String?
  attendeesCount    Int
  remarks           String?
  bookingStatus     BookingStatus     @default(PENDING)
  managerApprovalStatus ManagerApprovalStatus @default(NOT_REQUIRED)
  managerReviewedAt DateTime?
  managerReviewerName String?
  managerReviewerEmail String?
  createdByRole     UserRole          @default(STANDARD)
  overrideCapacity  Boolean           @default(false)
  cancelledAt       DateTime?
  cancellationNotes String?
  room              Room              @relation(fields: [roomId], references: [id])
  manager           User?             @relation("ReservationManager", fields: [managerId], references: [id])
  auditEntries      ReservationAudit[]
  drinkOrders       DrinkOrder[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([roomId, reservationDate])
  @@index([managerId, managerApprovalStatus, bookingStatus])
}

model ReservationAudit {
  id             String      @id @default(cuid())
  reservationId  String
  action         String
  actorName      String
  actorEmail     String
  actorRole      UserRole
  notes          String?
  snapshot       String?
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@index([reservationId, createdAt])
}

model StoredFile {
  id           String   @id @default(cuid())
  kind         String
  originalName String
  contentType  String?
  size         Int
  bytes        Bytes
  createdAt    DateTime @default(now())
}

model RoomServiceToken {
  id         String   @id @default(cuid())
  roomId      String   @unique
  token       String   @unique
  isEnabled   Boolean  @default(true)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  drinkOrders DrinkOrder[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id               String             @id @default(cuid())
  name             String
  nameArabic       String?
  category         String
  description      String?
  descriptionArabic String?
  imageAttachment  String?
  isActive         Boolean            @default(true)
  isOutOfStock     Boolean            @default(false)
  allowCustomNote  Boolean            @default(true)
  sortOrder        Int                @default(0)
  modifiers        MenuItemModifier[]
  drinkOrders      DrinkOrder[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([category, sortOrder])
}

model MenuItemModifier {
  id         String   @id @default(cuid())
  menuItemId String
  label      String
  labelArabic String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([menuItemId, sortOrder])
}

model DrinkOrder {
  id                 String           @id @default(cuid())
  reservationId      String?
  roomId             String
  roomServiceTokenId String?
  menuItemId         String
  guestLabel         String?
  itemNameSnapshot   String
  modifierSummary    String?
  customNote         String?
  status             DrinkOrderStatus @default(NEW)
  submittedAt        DateTime         @default(now())
  preparingAt        DateTime?
  servedAt           DateTime?
  guestReminderRequestedAt DateTime?
  reservation        Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  room               Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomServiceToken   RoomServiceToken? @relation(fields: [roomServiceTokenId], references: [id], onDelete: SetNull)
  menuItem           MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([roomId, submittedAt])
  @@index([reservationId, status])
  @@index([status, submittedAt])
}
