# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
POSTGRES_USER="your_postgres_user"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="your_database_name"

# SMTP Email Configuration
SMTP_HOST="smtp.host.com"                  # SMTP server host
SMTP_PORT="587"                             # 587 for TLS, 465 for SSL
SMTP_SECURE="false"                         # true if using port 465 (SSL)
SMTP_USER="your_email@gmail.com"            # SMTP login username
SMTP_PASS="your_email_password"             # SMTP login password or app password
SMTP_FROM="no-reply@yourdomain.com"         # From address shown in sent emails

# Admin Account (used for seeding the first admin user)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="changeme123"

# Security
SESSION_SECRET="a_long_random_string_here"  # Secret used to sign sessions, keep it long and random
CRON_SECRET="another_random_string_here"    # Bearer token to protect cron job endpoints

# Upload Configuration
BODY_SIZE_LIMIT="50mb"                      # Max file upload size (e.g. 10mb, 50mb, 100mb)