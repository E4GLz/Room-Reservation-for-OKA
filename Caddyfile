# Caddy reverse proxy for the OKA Room Reservation Platform.
#
# APP_DOMAIN is read from .env (see .env.example).
#   - Set it to your real hostname (e.g. rooms.obeikan.com) and Caddy will
#     obtain and auto-renew a Let's Encrypt TLS certificate for it.
#   - Leave it as the default `localhost` for local testing; Caddy then serves
#     over its own internal self-signed certificate.
#
# Ports 80 and 443 must be reachable from the internet and the domain's DNS
# record must already point at this host before certificate issuance can work.

{$APP_DOMAIN:localhost} {
	encode zstd gzip

	# The app container is reached over the internal Compose network.
	# It is not published to the public internet directly.
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		# Block MIME-type sniffing on every response.
		X-Content-Type-Options "nosniff"
		# Disallow framing of the app by other origins.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove the server banner.
		-Server
	}

	log {
		output stdout
		format console
	}
}
